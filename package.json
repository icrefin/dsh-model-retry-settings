{
  "name": "dsh-model-retry-settings",
  "version": "1.0.2",
  "description": "Max-retries control for DeepSeek Harness: adds one preference card to the web client's Settings → Model page that sets how many times a failed model request is retried.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "retry",
    "max-retries",
    "settings",
    "llm-retry"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.2.2-0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "sh scripts/verify.sh",
    "test": "sh scripts/verify.sh",
    "pack": "sh scripts/install.sh",
    "dev": "sh scripts/dev-profile.sh boot",
    "dev:dump": "sh scripts/dev-profile.sh dump",
    "dev:clean": "sh scripts/dev-profile.sh remove"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "packageManager": "pnpm@11.20.0"
}
